---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getSettings, getCategories } from '../../server/repo';
import { db } from '../../server/firebase';
import { MAX_TESTIMONIAL_LENGTH } from '../../lib/testimonials';
import { timingSafeEqual } from 'node:crypto';
import type { Order } from '../../lib/types';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const [settings, categories] = await Promise.all([getSettings(), getCategories()]);
const orderId = Astro.params.orderId ?? '';
const token = Astro.url.searchParams.get('t') ?? '';
let state: 'ok' | 'invalido' | 'ja' = 'invalido';
let firstName = '';
if (orderId && token && orderId.length < 64) {
  const snap = await db().doc(`orders/${orderId}`).get();
  const o = snap.data() as Order | undefined;
  const same = (a: string, b: string) => a.length === b.length && timingSafeEqual(Buffer.from(a), Buffer.from(b));
  if (o && o.reviewToken && same(o.reviewToken, token) && !o.deletedAt && o.status !== 'cancelado') {
    state = o.reviewSubmitted ? 'ja' : 'ok';
    firstName = (o.customer?.name ?? '').split(' ')[0];
  }
}
---
<Base title="Avaliar compra" description="Conte como foi sua compra na Loja do Trabalhador." settings={settings} categories={categories} noindex>
  <div class="container" style="max-width:720px;padding-top:32px;padding-bottom:48px">
    {state === 'invalido' && (
      <div class="panel">
        <h1>Link de avaliação inválido</h1>
        <p>Este link não é válido ou expirou. Se você comprou com a gente, peça um novo link pelo WhatsApp.</p>
        <a class="btn btn-primary" href="/">Ir para a loja</a>
      </div>
    )}
    {state === 'ja' && (
      <div class="panel">
        <h1>Obrigado!</h1>
        <p>Este pedido já foi avaliado. Agradecemos muito por contar como foi.</p>
        <a class="btn btn-primary" href="/loja">Voltar para a loja</a>
      </div>
    )}
    {state === 'ok' && (
      <form class="panel form-grid" id="review-form" data-order={orderId} data-token={token} novalidate>
        <span class="badge badge-verified" style="justify-self:start"><Icon name="badge-check" /> Compra verificada</span>
        <h1>{firstName ? `${firstName}, como foi sua compra?` : 'Como foi sua compra?'}</h1>
        <p class="muted" style="margin:0">Sua opinião ajuda outros clientes e ajuda a gente a melhorar. Leva menos de 1 minuto.</p>
        <div id="review-error" class="alert alert-error" role="alert" tabindex="-1" hidden></div>
        <fieldset class="stars-input">
          <legend class="label" style="width:100%;margin-bottom:6px">Sua nota *</legend>
          {[1, 2, 3, 4, 5].map((n) => (
            <label><input type="radio" name="rating" value={n} required /><span aria-hidden="true">{n} ★</span><span class="sr-only">{n} de 5</span></label>
          ))}
        </fieldset>
        <div class="field">
          <label for="r-text">Seu depoimento *</label>
          <textarea class="textarea" id="r-text" name="text" maxlength={MAX_TESTIMONIAL_LENGTH} required placeholder="Conte o que comprou, como foi o atendimento e a entrega."></textarea>
          <span class="hint"><span id="r-count">0</span>/{MAX_TESTIMONIAL_LENGTH}</span>
        </div>
        <div class="form-grid two">
          <div class="field">
            <label for="r-name">Seu nome *</label>
            <input class="input" id="r-name" name="name" required maxlength="80" autocomplete="name" />
            <span class="hint">No site aparece só o primeiro nome e a inicial do sobrenome.</span>
          </div>
          <div class="field">
            <label for="r-role">Empresa ou profissão (opcional)</label>
            <input class="input" id="r-role" name="role" maxlength="80" placeholder="Ex.: Síndico, Oficina mecânica" />
          </div>
        </div>
        <div class="field" style="display:none" aria-hidden="true"><label for="r-website">Não preencha</label><input id="r-website" name="website" tabindex="-1" autocomplete="off" /></div>
        <label class="check">
          <input type="checkbox" name="consent" id="r-consent" />
          <span>Autorizo a Loja do Trabalhador a publicar meu depoimento no site com meu primeiro nome.</span>
        </label>
        <button class="btn btn-buy btn-lg" type="submit">Enviar avaliação</button>
      </form>
      <div class="panel confirm" id="review-done" hidden tabindex="-1">
        <Icon name="circle-check" class="icon big-check" />
        <h2>Obrigado pela avaliação!</h2>
        <p>Recebemos seu depoimento. Ele passa por uma conferência rápida antes de aparecer no site.</p>
        <a class="btn btn-primary" href="/loja">Voltar para a loja</a>
      </div>
    )}
  </div>
</Base>

<script>
  const form = document.getElementById('review-form') as HTMLFormElement | null;
  if (form) {
    const text = form.querySelector<HTMLTextAreaElement>('#r-text')!;
    const count = document.getElementById('r-count')!;
    text.addEventListener('input', () => (count.textContent = String(text.value.length)));
    const err = document.getElementById('review-error')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      const fd = new FormData(form);
      const rating = Number(fd.get('rating'));
      const problems: string[] = [];
      if (!rating) problems.push('Escolha uma nota.');
      if (String(fd.get('text') || '').trim().length < 10) problems.push('Escreva pelo menos uma frase.');
      if (String(fd.get('name') || '').trim().length < 2) problems.push('Informe seu nome.');
      if (problems.length) {
        err.textContent = problems.join(' ');
        err.hidden = false;
        err.focus();
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true;
      try {
        const res = await fetch('/api/submit-review', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            orderId: form.dataset.order, token: form.dataset.token, rating, text: fd.get('text'), name: fd.get('name'),
            role: fd.get('role'), consent: fd.get('consent') === 'on', website: fd.get('website'),
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.message || 'Não foi possível enviar agora.');
        form.hidden = true;
        const done = document.getElementById('review-done')!;
        done.hidden = false;
        done.focus();
      } catch (ex) {
        err.textContent = (ex as Error).message;
        err.hidden = false;
        err.focus();
        btn.disabled = false;
      }
    });
  }
</script>
