---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getSettings, getCategories } from '../server/repo';
import { setPublicCache } from '../server/http';
import { filled } from '../content/defaults';

export const prerender = false;
setPublicCache(Astro.response.headers);
const [settings, categories] = await Promise.all([getSettings(), getCategories()]);
const city = filled(settings.city) ? ` em ${settings.city}` : '';
const benefits = [
  { icon: 'repeat', title: 'Compra recorrente', text: 'Reposição de material de limpeza e EPIs no ritmo da sua operação.' },
  { icon: 'handshake', title: 'Atendimento dedicado', text: 'Entendemos sua necessidade antes de indicar o produto e a quantidade.' },
  { icon: 'boxes', title: 'Orçamento por quantidade', text: 'Mande a lista e receba a proposta pelo WhatsApp.' },
  { icon: 'truck', title: 'Entrega', text: 'Frete grátis na região local; fora dela, combinamos com você.' },
];
const segments = [
  { icon: 'building-2', name: 'Condomínios' },
  { icon: 'hard-hat', name: 'Obras e construtoras' },
  { icon: 'wrench', name: 'Oficinas e lava-rápidos' },
  { icon: 'factory', name: 'Indústrias' },
  { icon: 'briefcase', name: 'Escritórios e comércios' },
];
---
<Base title={`Empresas e condomínios — orçamento de material de limpeza e EPI${city}`} description={`Orçamento de material de limpeza, EPIs, botinas e ferramentas para empresas, condomínios, obras e oficinas${city}. Compra recorrente e atendimento dedicado.`} settings={settings} categories={categories}>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <p class="eyebrow" style="color:#9cc8ef">Para empresas · {settings.slogan}</p>
        <h1>Material de limpeza e EPI para sua empresa, condomínio ou obra</h1>
        <p class="lead">Conte o que você precisa e a quantidade. A gente entende sua rotina e monta o orçamento.</p>
        <a class="btn btn-buy btn-lg" href="#orcamento">Pedir orçamento</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Por que comprar com a gente</h2>
      <div class="pillars" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
        {benefits.map((b) => <div class="pillar"><Icon name={b.icon} /><h3>{b.title}</h3><p class="muted" style="margin:0">{b.text}</p></div>)}
      </div>
      <h2 style="margin-top:40px">Quem a gente atende</h2>
      <ul class="cat-grid" style="list-style:none;padding:0;margin:0">
        {segments.map((s) => <li class="cat-card"><Icon name={s.icon} />{s.name}</li>)}
      </ul>
    </div>
  </section>
  <section class="section" style="padding-top:0" id="orcamento">
    <div class="container" style="max-width:820px">
      <form class="panel form-grid" id="lead-form" novalidate>
        <h2 style="margin:0">Pedir orçamento</h2>
        <p class="muted" style="margin:0">Respondemos pelo WhatsApp. Campos com * são obrigatórios.</p>
        <div id="lead-error" class="alert alert-error" role="alert" tabindex="-1" hidden></div>
        <div class="form-grid two">
          <div class="field"><label for="l-name">Seu nome *</label><input class="input" id="l-name" name="name" required maxlength="80" autocomplete="name" /></div>
          <div class="field"><label for="l-company">Empresa / condomínio *</label><input class="input" id="l-company" name="company" required maxlength="100" autocomplete="organization" /></div>
          <div class="field">
            <label for="l-segment">Segmento</label>
            <select class="select" id="l-segment" name="segment">
              <option value="">Selecione</option>
              {segments.map((s) => <option>{s.name}</option>)}
              <option>Outro</option>
            </select>
          </div>
          <div class="field"><label for="l-city">Cidade</label><input class="input" id="l-city" name="city" maxlength="80" autocomplete="address-level2" /></div>
          <div class="field"><label for="l-phone">WhatsApp *</label><input class="input" id="l-phone" name="phone" type="tel" inputmode="tel" required maxlength="20" autocomplete="tel" placeholder="(00) 00000-0000" /></div>
          <div class="field"><label for="l-email">E-mail</label><input class="input" id="l-email" name="email" type="email" maxlength="120" autocomplete="email" /></div>
        </div>
        <div class="field">
          <label for="l-items">O que você precisa? Itens e quantidades *</label>
          <textarea class="textarea" id="l-items" name="items" required maxlength="1500" placeholder="Ex.: 10 galões de desinfetante, 20 pares de luva tamanho G, 5 capacetes..."></textarea>
        </div>
        <div class="field" style="display:none" aria-hidden="true"><label for="l-website">Não preencha</label><input id="l-website" name="website" tabindex="-1" autocomplete="off" /></div>
        <label class="check"><input type="checkbox" name="acceptPrivacy" id="l-privacy" /><span>Li e aceito a <a href="/politicas#privacidade" target="_blank">política de privacidade</a>. *</span></label>
        <button class="btn btn-buy btn-lg" type="submit">Enviar pedido de orçamento</button>
      </form>
      <div class="panel confirm" id="lead-done" hidden tabindex="-1">
        <Icon name="circle-check" class="icon big-check" />
        <h2>Pedido de orçamento recebido!</h2>
        <p>Já registramos sua solicitação. Para agilizar, envie também pelo WhatsApp:</p>
        <a class="btn btn-whats btn-lg" id="lead-whats" href="#" target="_blank" rel="noopener" data-whats="orcamento"><Icon name="message-circle" /> Enviar no WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { normalizePhone } from '../lib/phone';
  import { track } from '../client/ui';
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const err = document.getElementById('lead-error')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const fd = new FormData(form);
    const v = (k: string) => String(fd.get(k) ?? '').trim();
    const problems: string[] = [];
    if (v('name').length < 2) problems.push('Informe seu nome.');
    if (v('company').length < 2) problems.push('Informe a empresa ou condomínio.');
    if (!normalizePhone(v('phone'))) problems.push('Informe um WhatsApp com DDD.');
    if (v('items').length < 3) problems.push('Conte o que você precisa.');
    if (!fd.get('acceptPrivacy')) problems.push('É preciso aceitar a política de privacidade.');
    if (problems.length) {
      err.textContent = problems.join(' ');
      err.hidden = false;
      err.focus();
      return;
    }
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    try {
      const res = await fetch('/api/submit-lead', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name: v('name'), company: v('company'), segment: v('segment'), city: v('city'), phone: v('phone'), email: v('email'), items: v('items'), acceptPrivacy: true, website: v('website') }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.message || 'Não foi possível enviar agora. Chame no WhatsApp.');
      form.hidden = true;
      const done = document.getElementById('lead-done')!;
      (document.getElementById('lead-whats') as HTMLAnchorElement).href = data.whatsappUrl;
      done.hidden = false;
      done.focus();
      track('generate_lead', {});
      const w = window.open(data.whatsappUrl, '_blank');
      if (w) w.opener = null;
    } catch (ex) {
      err.textContent = (ex as Error).message;
      err.hidden = false;
      err.focus();
      btn.disabled = false;
    }
  });
</script>
