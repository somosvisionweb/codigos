---
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';
import { whatsappLink } from '../lib/whatsapp';
import type { Category, Product } from '../lib/types';

interface Props { products: Product[]; categories: Category[]; current?: string; threshold: number; whatsapp: string }
const { products, categories, current = '', threshold, whatsapp } = Astro.props;
const catName = Object.fromEntries(categories.map((c) => [c.id, c.name]));
const notFound = whatsappLink(whatsapp, 'Olá! Procurei um produto no site e não encontrei. Vocês têm');
---
<div class="shop" data-shop data-current={current}>
  <nav class="chips" aria-label="Categorias">
    <a class="chip" href="/loja" aria-current={!current ? 'page' : undefined} data-chip="">Todos</a>
    {categories.map((c) => (
      <a class="chip" href={`/categoria/${c.slug}`} aria-current={current === c.id ? 'page' : undefined} data-chip={c.id}>{c.name}</a>
    ))}
  </nav>
  <div class="shop-tools">
    <div class="search-form">
      <label class="sr-only" for="shop-q">Buscar nesta lista</label>
      <input id="shop-q" class="input" type="search" placeholder="Buscar: botina, luva, desinfetante..." autocomplete="off" data-shop-q />
    </div>
    <div>
      <label class="sr-only" for="shop-sort">Ordenar por</label>
      <select id="shop-sort" class="select" data-shop-sort>
        <option value="relevancia">Ordenar: relevância</option>
        <option value="menor">Menor preço</option>
        <option value="maior">Maior preço</option>
        <option value="az">A–Z</option>
      </select>
    </div>
  </div>
  <p class="result-count" data-shop-count aria-live="polite">{products.length} {products.length === 1 ? 'produto' : 'produtos'}</p>
  <div class="product-grid" data-shop-grid>
    {products.map((p, i) => <ProductCard product={p} threshold={threshold} whatsapp={whatsapp} categoryName={catName[p.categoryId]} index={i} eager={i < 4} />)}
  </div>
  <div class="empty" data-shop-empty hidden={products.length > 0}>
    <Icon name="search" />
    <p><strong>Não achou?</strong> Chame no WhatsApp que a gente procura para você.</p>
    <a class="btn btn-whats" href={notFound} target="_blank" rel="noopener" data-whats="busca-vazia" data-shop-wa><Icon name="message-circle" /> Chamar no WhatsApp</a>
  </div>
</div>

<script>
  import { matchesSearch } from '../lib/text';

  const root = document.querySelector<HTMLElement>('[data-shop]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-shop-grid]')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-product]')];
    const q = root.querySelector<HTMLInputElement>('[data-shop-q]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-shop-sort]')!;
    const count = root.querySelector<HTMLElement>('[data-shop-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-shop-empty]')!;
    const wa = root.querySelector<HTMLAnchorElement>('[data-shop-wa]');
    const waBase = wa?.href ?? '';
    const params = new URLSearchParams(location.search);
    q.value = params.get('q') ?? '';
    if (['menor', 'maior', 'az'].includes(params.get('ordem') ?? '')) sort.value = params.get('ordem')!;

    const apply = () => {
      const term = q.value.trim();
      const visible = cards.filter((c) => {
        const ok = !term || matchesSearch(c.dataset.name ?? '', term);
        c.hidden = !ok;
        return ok;
      });
      const by = sort.value;
      const sorted = [...cards].sort((a, b) => {
        if (by === 'menor') return Number(a.dataset.price) - Number(b.dataset.price);
        if (by === 'maior') return Number(b.dataset.price) - Number(a.dataset.price);
        if (by === 'az') return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '', 'pt-BR');
        return Number(a.dataset.index) - Number(b.dataset.index);
      });
      grid.append(...sorted);
      const n = visible.length;
      count.textContent = `${n} ${n === 1 ? 'produto' : 'produtos'}${term ? ` para “${term}”` : ''}`;
      empty.hidden = n > 0;
      if (wa) {
        const u = new URL(waBase);
        u.searchParams.set('text', `Olá! Procurei "${term || 'um produto'}" no site e não encontrei. Vocês têm?`);
        wa.href = u.toString();
      }
      const url = new URL(location.href);
      if (term) url.searchParams.set('q', term); else url.searchParams.delete('q');
      if (by !== 'relevancia') url.searchParams.set('ordem', by); else url.searchParams.delete('ordem');
      history.replaceState(null, '', url);
    };
    q.addEventListener('input', apply);
    sort.addEventListener('change', apply);
    // Mantém a busca ao trocar de categoria
    root.querySelectorAll<HTMLAnchorElement>('[data-chip]').forEach((chip) => {
      chip.addEventListener('click', () => {
        const u = new URL(chip.href);
        if (q.value.trim()) u.searchParams.set('q', q.value.trim());
        chip.href = u.toString();
      });
    });
    apply();
  }
</script>
