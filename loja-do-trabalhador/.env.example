# Copie para .env (que NÃO vai para o git) e preencha. Veja docs/SETUP.md.

# ---- Servidor (Netlify → Site configuration → Environment variables). NUNCA vão para o navegador.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# URL pública do site (canonical, sitemap, links de avaliação). Ex.: https://www.seudominio.com.br
SITE_URL=

# ---- Painel (públicas por natureza: configuração web do Firebase, não são segredos)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_APP_ID=

# ---- Somente desenvolvimento local com emuladores (deixe vazio em produção)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# PUBLIC_USE_EMULATORS=true
# SHOW_DEMO_TESTIMONIALS=true

# ---- create-admin (opcional; se vazio, o script pergunta no terminal)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_ROLE=
